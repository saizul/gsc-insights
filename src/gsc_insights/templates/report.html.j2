<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root { --ink:#1b1f24; --muted:#5b6570; --line:#e3e7eb; --bg:#f6f8fa; --card:#fff; --accent:#1f6feb; --accent2:#2da44e; }
  * { box-sizing: border-box; }
  body { margin:0; font:15px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif; color:var(--ink); background:var(--bg); }
  header, main { max-width:1100px; margin:0 auto; padding:24px 20px; }
  header { padding-bottom:0; }
  h1 { margin:0 0 4px; font-size:26px; }
  h2 { margin:0 0 6px; font-size:18px; }
  .sub { color:var(--muted); font-size:13px; }
  .kpis { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:12px; margin:16px 0; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:16px; margin-bottom:16px; }
  .kpi .label { color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.04em; }
  .kpi .value { font-size:26px; font-weight:650; }
  .kpi .delta { color:var(--muted); font-size:12px; min-height:18px; }
  table { width:100%; border-collapse:collapse; font-size:13px; }
  th, td { text-align:left; padding:6px 8px; border-bottom:1px solid var(--line); vertical-align:top; word-break:break-word; }
  th { color:var(--muted); font-weight:600; background:#fafbfc; }
  td.num { text-align:right; font-variant-numeric:tabular-nums; }
  nav a { margin-right:12px; font-size:13px; color:var(--accent); text-decoration:none; }
  .note { color:var(--muted); font-size:13px; margin:0 0 10px; }
  svg { width:100%; height:80px; display:block; }
  .legend span { font-size:12px; margin-right:14px; }
  footer { max-width:1100px; margin:0 auto; padding:0 20px 32px; color:var(--muted); font-size:12px; }
</style>
</head>
<body>
<header>
  <h1>{{ title }}</h1>
  <div class="sub">Generated {{ generated }} by gsc-insights {{ version }}{% if compare %} &middot; comparing period A (earlier) with period B (later){% endif %}</div>
</header>
<main>
  <div class="kpis">
  {% for k in kpis %}
    <div class="card kpi"><div class="label">{{ k.label }}</div><div class="value">{{ k.value }}</div><div class="delta">{{ k.delta }}</div></div>
  {% endfor %}
  </div>

  {% if trend %}
  <div class="card">
    <h2>Daily trend</h2>
    <div class="sub">{{ trend.start }} to {{ trend.end }}</div>
    <svg viewBox="0 0 600 80" preserveAspectRatio="none" role="img" aria-label="Daily clicks and impressions">
      <polyline fill="none" stroke="#1f6feb" stroke-width="2" points="{{ trend.clicks }}"/>
    </svg>
    <svg viewBox="0 0 600 80" preserveAspectRatio="none" role="img" aria-label="Daily impressions">
      <polyline fill="none" stroke="#2da44e" stroke-width="2" points="{{ trend.impressions }}"/>
    </svg>
    <div class="legend"><span style="color:#1f6feb">&#9632; Clicks</span><span style="color:#2da44e">&#9632; Impressions</span></div>
  </div>
  {% endif %}

  {% if sections %}
  <nav>
  {% for s in sections %}<a href="#{{ s.id }}">{{ s.title }}</a>{% endfor %}
  </nav>
  <br>
  {% endif %}

  {% for s in sections %}
  <section class="card" id="{{ s.id }}">
    <h2>{{ s.title }}</h2>
    {% if s.note %}<p class="note">{{ s.note }}</p>{% endif %}
    <table>
      <thead><tr>{% for h in s.headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
      <tbody>
      {% for row in s.rows %}
        <tr>{% for cell in row %}<td{% if not loop.first and cell[:1] in '0123456789+-' %} class="num"{% endif %}>{{ cell }}</td>{% endfor %}</tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {% else %}
  <div class="card">No sections to show. Check your thresholds or provide more export files.</div>
  {% endfor %}
</main>
<footer>Built with gsc-insights by Saizul Amin &middot; saizul.com</footer>
</body>
</html>
